# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real keys.

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-3.5-flash is the extraction model. Do not use gemini-3.1-flash-lite:
# it fabricates quotes, stitching fragments with ellipses ("helps the... cramp")
# that do not appear in the source. Free-tier daily caps are per model, so a
# 429 on one model does not mean the key is exhausted.
GEMINI_MODEL=gemini-3.5-flash
# Note (2026-11-05): the API answers gemini-3.5-flash requests with gemini-3.6-flash, and the free
# and paid tiers often return 500/503. The description check was therefore run through the web
# chat (Gemini 3.8 Flash, temp 0): description_check.py --export-web / --import-web.

# Biodiversity Heritage Library (free key: https://www.biodiversitylibrary.org/getapikey.aspx)
# used by description_sources/bhl/
BHL_API_KEY=

# TypeSafe AI (Jev) — leave blank until we have a key.
TYPESAFE_API_KEY=
JEV_MODEL=

# Anakin (hackathon sponsor): turns a website without an API into JSON. Free for one month.
ANAKIN_API_KEY=

