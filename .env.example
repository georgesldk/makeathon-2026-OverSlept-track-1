# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real keys.

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-3.5-flash is the extraction model. Do not use gemini-3.1-flash-lite:
# it fabricates quotes, stitching fragments with ellipses ("helps the... cramp")
# that do not appear in the source. Free-tier daily caps are per model, so a
# 429 on one model does not mean the key is exhausted.
GEMINI_MODEL=gemini-3.5-flash

# TypeSafe AI (Jev) — leave blank until we have a key.
TYPESAFE_API_KEY=
JEV_MODEL=
