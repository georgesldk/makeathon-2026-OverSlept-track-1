// EthnoTrace schema — Neo4j 5.x / Cypher. Run against the intended database.
// Constraints protect IDs when present; ingestion is responsible for providing IDs.
CREATE CONSTRAINT ethnotrace_snapshot_id IF NOT EXISTS FOR (n:PipelineSnapshot) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_dataset_import_id IF NOT EXISTS FOR (n:DatasetImport) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_book_id IF NOT EXISTS FOR (n:Book) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_entry_id IF NOT EXISTS FOR (n:HistoricalEntry) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_name_id IF NOT EXISTS FOR (n:HistoricalName) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_hypothesis_id IF NOT EXISTS FOR (n:IdentificationHypothesis) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_evidence_id IF NOT EXISTS FOR (n:EvidenceRecord) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_source_id IF NOT EXISTS FOR (n:EvidenceSource) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_decision_id IF NOT EXISTS FOR (n:EligibilityDecision) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_taxonomy_id IF NOT EXISTS FOR (n:TaxonomicResolution) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_description_id IF NOT EXISTS FOR (n:DescriptionComparison) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_candidate_description_id IF NOT EXISTS FOR (n:CandidateDescription) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_description_score_id IF NOT EXISTS FOR (n:DescriptionScore) REQUIRE n.id IS UNIQUE;
// Shared only within a particular authority and release; names are not identifiers.
CREATE CONSTRAINT ethnotrace_taxon_id IF NOT EXISTS FOR (n:Taxon) REQUIRE n.id IS UNIQUE;
// Claim and study data are not generated by schema initialization.
CREATE CONSTRAINT ethnotrace_claim_id IF NOT EXISTS FOR (n:HistoricalClaim) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_concept_id IF NOT EXISTS FOR (n:MedicalConcept) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_mapping_id IF NOT EXISTS FOR (n:ConceptMapping) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_claim_link_id IF NOT EXISTS FOR (n:ClaimLink) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_claim_unit_id IF NOT EXISTS FOR (n:ClaimPlantUnit) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_study_id IF NOT EXISTS FOR (n:Study) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_assessment_id IF NOT EXISTS FOR (n:EvidenceAssessment) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ethnotrace_excerpt_id IF NOT EXISTS FOR (n:EvidenceExcerpt) REQUIRE n.id IS UNIQUE;
CREATE INDEX ethnotrace_entry_name IF NOT EXISTS FOR (n:HistoricalEntry) ON (n.name);
CREATE INDEX ethnotrace_hypothesis_name IF NOT EXISTS FOR (n:IdentificationHypothesis) ON (n.accepted_name);
CREATE INDEX ethnotrace_decision_tier IF NOT EXISTS FOR (n:EligibilityDecision) ON (n.tier);
