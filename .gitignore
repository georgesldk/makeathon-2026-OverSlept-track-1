# Raw API replies, rebuilt by the source scripts
common_name_sources/gbif/*/cache/
common_name_sources/wikidata/*/cache/
common_name_sources/inaturalist/*/cache/
common_name_sources/checklistbank/*/cache/
common_name_sources/taxtree/*/cache/
matching/*/cache/
scientific_name_sources/*/*/cache/
scientific_name_sources/*/cache/

# Full datasets downloaded by hand (see DATA_SOURCES.md for where to get them)
common_name_sources/drduke/data/
scientific_name_sources/wcvp/data/

# Raw source outputs: large, rebuilt by the source scripts from their caches
# (shared outside git, see MISSING_FILES.md)
common_name_sources/*/*/*.json
scientific_name_sources/*/*/*.json

# Description sources: raw API replies
description_sources/*/cache/
# Description sources: raw outputs per book (rebuilt by the scripts; shared outside git, see MISSING_FILES.md)
description_sources/*/*/*.json
# ...except the description check's results, which are a pipeline result like geography.json
!description_sources/check/*/description_check.json
# Web-chat prompts and the pasted replies (the replies are the only copy: shared outside git)
description_sources/check/web/
# Paper test: the paper's data files (redistribution not checked); RESULTS.md stays tracked
description_sources/paper_test/data/
description_sources/paper_test/results.json
description_sources/paper_test/prompts/
# macOS
.DS_Store
# MeSH download (the index mesh_index.json.gz is built from it and is in git)
reference_sources/mesh/desc20*
# Claims: web-chat prompts and pasted replies (the replies are the only copy: shared outside git)
claims/web/
claims/cache/
# Disease Ontology download (doid.obo, release recorded in claims/historical_terms.csv)
reference_sources/doid/
# Stage 3: full unit files are rebuilt by stage3/build_units.py (pilot.jsonl stays in git)
stage3/units/culpeper.jsonl
stage3/units/dioscorides.jsonl
# Stage 3: NCBI cache and PubMed abstracts (publisher copyright): outside git, shared in the zip
stage3/cache/
stage3/texts/
# Stage 3: web-chat prompts and pasted replies (only copy: shared outside git)
stage3/web/

# Stage 3 paper test: rows from Lardos et al. data file 7 (not redistributed) and the pasted prompts
stage3/paper_test/expert_studies.jsonl
stage3/paper_test/web/

# Local working copies of Claude chat outputs (plans, audits, drafts): not part of the project
Claude outputs/

# ctext.org replies: kept out of git until its reuse terms are checked
historical_texts/shennong/source/
